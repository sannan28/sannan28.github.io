# install nacos 2.2.0
# 拉取指定版本的Nacos镜像（v2.2.0）
1.docker pull nacos/nacos-server:v2.2.0 (docker.io/nacos/nacos-server:v2.2.0)  
# 创建日志和配置文件目录，用于容器数据持久化 这些目录将映射到容器内部，方便直接修改配置
1.mkdir -p /mydata/nacos/logs/
2.mkdir -p /mydata/nacos/conf/
# 启动临时容器并复制配置文件
1.docker run -d --name nacos-temp -p 8848:8848 nacos/nacos-server:v2.2.0   临时启动容器
2.docker cp nacos-temp:/home/nacos/logs/ /mydata/nacos/  复制配置文件和日志
3.docker cp nacos-temp:/home/nacos/conf/ /mydata/nacos/  复制配置文件和日志
4.docker rm -f nacos-temp 移除临时容器
# 初始化MySQL数据库
1.创建数据库：在MySQL中新建数据库（如nacos-config）
# 导入表结构：从Nacos官方GitHub仓库下载SQL脚本并执行  执行sql获取链接 https://github.com/alibaba/nacos/blob/2.2.0/distribution/conf/mysql-schema.sql
2.source /path/to/mysql-schema.sql 
# 启动Nacos容器并配置MySQL
1.docker run -d --name nacos-2.2.0 -p 8848:8848 -p 9848:9848 -p 9849:9849 --privileged=true -e JVM_XMS=256m -e JVM_XMX=256m -e MODE=standalone -e SPRING_DATASOURCE_PLATFORM=mysql -e DB_NUM=1 -e DB_URL_0="jdbc:mysql://192.168.64.14:3307/nacos?characterEncoding=utf8&connectTimeout=1000&socketTimeout=30000&autoReconnect=true&useUnicode=true&useSSL=false&serverTimezone=Asia/Shanghai" -e DB_USER=root -e DB_PASSWORD=root -v /mydata/nacos/logs/:/home/nacos/logs -v /mydata/nacos/conf/:/home/nacos/conf --restart=always nacos/nacos-server:v2.2.0
2.docker run -d --name nacos-2.2.0 -p 8848:8848 -p 9848:9848 -p 9849:9849 --privileged=true -e JVM_XMS=256m -e JVM_XMX=256m -e MODE=standalone -e SPRING_DATASOURCE_PLATFORM=mysql -e DB_NUM=1 -e DB_URL_0="jdbc:mysql://192.168.64.14:3307/nacos?characterEncoding=utf8&connectTimeout=10000&socketTimeout=30000&autoReconnect=true&useUnicode=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai" -e DB_USER=root -e DB_PASSWORD=root -v /mydata/nacos/logs/:/home/nacos/logs -v /mydata/nacos/conf/:/home/nacos/conf  nacos/nacos-server:v2.2.0
# 修改配置文件
1.vim /mydata/nacos/conf/application.properties
# 更新以下配置项：
spring.datasource.platform=mysql
db.num=1
db.url.0=jdbc:mysql://<MySQL_IP>:3306/nacos-config?characterEncoding=utf8&connectTimeout=1000&socketTimeout=30000&autoReconnect=true&useUnicode=true&useSSL=false&serverTimezone=UTC
db.user=root
db.password=your_password
# 验证配置映射
1.docker exec -it nacos cat /home/nacos/conf/application.properties
# 防火墙与网络配置
1.firewall-cmd --permanent --add-port={8848,9848,9849}/tcp
2.firewall-cmd --reload
3.systemctl restart docker  # 可选，确保Docker应用新规则
# 访问Nacos控制台
1.http://<宿主机IP>:8848/nacos/index.html  
2.默认账号密码为 nacos/nacos


# install seata 1.6.1
1.docker pull seataio/seata-server:1.6.1
2.mkdir -p /opt/seata/config
3.mkdir -p /opt/seata/logs
4.docker run -d --name seata-temp -p 8091:8091 seataio/seata-server:1.6.1
5.docker cp seata-temp:/seata-server/resources /opt/seata/config
6.docker rm -f seata-temp
7.创建数据库：在MySQL中新建名为 seata 的数据库
8.导入表结构 参考链接：https://github.com/apache/incubator-seata/blob/1.6.1/script/server/db/mysql.sql
9.修改 /opt/seata/config/resources下的 application的yaml文件，可以参考 application.example.yaml文件
   需要修改的内容是：
seata：
  config:
    type: nacos
    nacos:
      server-addr: 192.168.64.14:8848
      namespace:
      group: DEFAULT_GROUP
      username: nacos
      password: nacos
      data-id: seataServer.properties

registry:
  type: nacos
  nacos:
    application: seata-server
    server-addr: 192.168.64.14:8848
    group: DEFAULT_GROUP
    namespace:
    username: nacos
    password: nacos

其中 data-id: seataServer.properties 这个配置文件 需要手动上传到nacos的配置中心 内容链接 https://github.com/apache/incubator-seata/blob/1.6.1/script/config-center/config.txt 
然后修改配置中关于mysql的相关的配置 
store.mode=db
store.lock.mode=db
store.session.mode=db
# 数据库连接配置
store.db.url=jdbc:mysql://192.168.64.14:3307/seata?characterEncoding=utf8&connectTimeout=10000&socketTimeout=30000&autoReconnect=true&useUnicode=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
store.db.user=root
store.db.password=root

9. docker run -d --name seata-1.6.1 -p 8091:8091 -e SEATA_IP=192.168.64.14 -e SEATA_CONFIG_NAME=file:/seata-server/resources/registry -v /opt/seata/config/resources:/seata-server/resources -v /opt/seata/logs:/root/logs/seata seataio/seata-server:1.6.1
10.docker logs -f seata //验证部署

以下11-12 步骤 可以忽略 但是内容先保存
11.配置注册中心和存储模式：
    vim /opt/seata/config/resources/registry.conf

    registry {
  type = "nacos"  # 使用Nacos作为注册中心（若需其他注册中心需调整）
  nacos {
    serverAddr = "nacos-host:8848"  # Nacos服务地址
    namespace = ""
    group = "SEATA_GROUP"
    username = "nacos"  # Nacos账号
    password = "nacos"  # Nacos密码
  }
}

config {
  type = "nacos"  # 使用Nacos作为配置中心（若需本地文件可改为file）
  nacos {
    serverAddr = "nacos-host:8848"
    group = "SEATA_GROUP"
    dataId = "seataServer.properties"
  }
}

12.配置MySQL持久化

wget https://repo1.maven.org/maven2/mysql/mysql-connector-java/8.0.19/mysql-connector-java-8.0.19.jar -P /opt/seata/config/resources/

vim /opt/seata/config/resources/file.conf
store {
  mode = "db"  # 使用MySQL存储事务日志
  db {
    datasource = "druid"
    dbType = "mysql"
    driverClassName = "com.mysql.cj.jdbc.Driver"
    url = "jdbc:mysql://192.168.64.14:3307/seata?characterEncoding=utf8&connectTimeout=10000&socketTimeout=30000&autoReconnect=true&useUnicode=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai"
    user = "root"        # MySQL用户名
    password = "root"  # MySQL密码
    minConn = 5
    maxConn = 30
  }
}


