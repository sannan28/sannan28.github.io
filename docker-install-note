install kafaka cluster version 3.0.2
# 创建项目目录并进入
1.mkdir kafka-cluster && cd kafka-cluster
# 需要为目录配置权限
2.chmod -R 777 ./kafka-cluster/
# 创建docker-compose.yml文件
cat << EOF > docker-compose.yml
version: '3.8'

services:
  zookeeper1:
    image: bitnami/zookeeper:3.8.2
    container_name: zookeeper1
    environment:
      - ZOO_SERVER_ID=1
      - ZOO_SERVERS=0.0.0.0:2888:3888;zookeeper2:2888:3888;zookeeper3:2888:3888
      - ALLOW_ANONYMOUS_LOGIN=yes
    ports:
      - "2181:2181"
    volumes:
      - ./zookeeper1/data:/bitnami/zookeeper/data
    networks:
      - kafka-net

  zookeeper2:
    image: bitnami/zookeeper:3.8.2
    container_name: zookeeper2
    environment:
      - ZOO_SERVER_ID=2
      - ZOO_SERVERS=zookeeper1:2888:3888;0.0.0.0:2888:3888;zookeeper3:2888:3888
      - ALLOW_ANONYMOUS_LOGIN=yes
    ports:
      - "2182:2181"
    volumes:
      - ./zookeeper2/data:/bitnami/zookeeper/data
    networks:
      - kafka-net

  zookeeper3:
    image: bitnami/zookeeper:3.8.2
    container_name: zookeeper3
    environment:
      - ZOO_SERVER_ID=3
      - ZOO_SERVERS=zookeeper1:2888:3888;zookeeper2:2888:3888;0.0.0.0:2888:3888
      - ALLOW_ANONYMOUS_LOGIN=yes
    ports:
      - "2183:2181"
    volumes:
      - ./zookeeper3/data:/bitnami/zookeeper/data
    networks:
      - kafka-net

  kafka1:
    image: bitnami/kafka:3.0.2
    container_name: kafka1
    environment:
      - KAFKA_BROKER_ID=1
      - KAFKA_CFG_ZOOKEEPER_CONNECT=zookeeper1:2181,zookeeper2:2181,zookeeper3:2181
      - KAFKA_CFG_LISTENERS=PLAINTEXT://:9092
      - KAFKA_CFG_ADVERTISED_LISTENERS=PLAINTEXT://kafka1:9092
      - ALLOW_PLAINTEXT_LISTENER=yes
    ports:
      - "9092:9092"
    depends_on:
      - zookeeper1
      - zookeeper2
      - zookeeper3
    volumes:
      - ./kafka1/data:/bitnami/kafka/data
    networks:
      - kafka-net

  kafka2:
    image: bitnami/kafka:3.0.2
    container_name: kafka2
    environment:
      - KAFKA_BROKER_ID=2
      - KAFKA_CFG_ZOOKEEPER_CONNECT=zookeeper1:2181,zookeeper2:2181,zookeeper3:2181
      - KAFKA_CFG_LISTENERS=PLAINTEXT://:9093
      - KAFKA_CFG_ADVERTISED_LISTENERS=PLAINTEXT://kafka2:9093
      - ALLOW_PLAINTEXT_LISTENER=yes
    ports:
      - "9093:9093"
    volumes:
      - ./kafka2/data:/bitnami/kafka/data
    networks:
      - kafka-net

  kafka3:
    image: bitnami/kafka:3.0.2
    container_name: kafka3
    environment:
      - KAFKA_BROKER_ID=3
      - KAFKA_CFG_ZOOKEEPER_CONNECT=zookeeper1:2181,zookeeper2:2181,zookeeper3:2181
      - KAFKA_CFG_LISTENERS=PLAINTEXT://:9094
      - KAFKA_CFG_ADVERTISED_LISTENERS=PLAINTEXT://kafka3:9094
      - ALLOW_PLAINTEXT_LISTENER=yes
    ports:
      - "9094:9094"
    volumes:
      - ./kafka3/data:/bitnami/kafka/data
    networks:
      - kafka-net

networks:
  kafka-net:
    driver: bridge
EOF
# 启动集群
4.docker compose up -d
# 查看集群状态
5.docker compose ps

    





















